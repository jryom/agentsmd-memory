{
  "name": "agentsmd-memory",
  "version": "1.0.0",
  "description": "Zero-dependency MCP server that gives AI agents a self-updating project memory in AGENTS.md. Returns merge instructions instead of mutating state, so every change is a reviewable diff.",
  "type": "module",
  "bin": {
    "agentsmd-memory": "src/index.mjs"
  },
  "main": "src/server.mjs",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "start": "node src/index.mjs",
    "prepublishOnly": "node --test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agents.md",
    "memory",
    "ai",
    "agent",
    "claude",
    "cursor",
    "opencode",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jryom/agentsmd-memory.git"
  },
  "homepage": "https://github.com/jryom/agentsmd-memory#readme",
  "bugs": {
    "url": "https://github.com/jryom/agentsmd-memory/issues"
  },
  "license": "MIT",
  "author": "jryom"
}
